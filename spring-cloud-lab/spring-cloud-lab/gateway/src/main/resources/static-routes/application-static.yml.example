# Routage STATIQUE (étape 5) : copier ce contenu dans application.yml,
# mettre spring.cloud.discovery.enabled=false et désactiver le RouteLocator Java.
spring:
  cloud:
    gateway:
      routes:
        - id: r1
          uri: "http://localhost:8088"
          predicates:
            - Path=/clients/**,/client/**
        - id: r2
          uri: "http://localhost:8089"
          predicates:
            - Path=/voitures/**
